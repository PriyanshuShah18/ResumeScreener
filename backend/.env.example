GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
# Optional: HuggingFace API key for serverless embedding inference (cloud-friendly, no PyTorch needed on server)
# Get your free key at https://huggingface.co/settings/tokens
# When set, this replaces the local Sentence-Transformers model with a fast HTTP API call.
HF_API_KEY=your_huggingface_api_key_here
MODEL_ID=qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434
MAX_RESUMES_PER_REQUEST=100

# ATS Mongo worker
# Prefer MONGODB_URI. MONGO_URI is also accepted for compatibility with existing env files.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/Os?appName=Cluster0
# MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/Os?appName=Cluster0
MONGODB_DB=Os
DEFAULT_ORGANIZATION_ID=codnestx
ATS_POLL_INTERVAL_SECONDS=60
ATS_BATCH_SIZE=25
ATS_AUTO_SHORTLIST=false
ATS_SHORTLIST_THRESHOLD=80
ATS_CACHE_PARSED_JSON=false

# AWS / S3-compatible resume storage
# Standard AWS env var names (S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY also accepted)
S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT_URL=https://your-minio-or-s3-compatible-endpoint

# Semantic matching knobs (optional overrides)
# SEMANTIC_MODEL_ENABLED=false         # Set to false to disable local PyTorch model entirely
# SEMANTIC_SKILL_GRAPH_ENABLED=true
# SEMANTIC_THRESHOLD=0.75
# SEMANTIC_PARTIAL_THRESHOLD=0.60
# SEMANTIC_REQUIRED_THRESHOLD=0.88
